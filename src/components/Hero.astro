---
/**
 * Úvodná sekcia.
 *
 * Pozadie je statický obrázok, nie video: hero je LCP prvok stránky a video
 * ho zdržiava o stovky milisekúnd. Ak zákazník dodá promo video, dá sa
 * pridať ako pozadie s `poster={hero.src}` — obrázok potom slúži ako plynulý
 * medzikrok, nie ako náhrada.
 */
import { Image } from 'astro:assets';
import { STATS } from '../data/site';
import hero from '../assets/site/hero.jpg';
---

<section class="hero" id="uvod">
  <Image
    class="hero__bg"
    src={hero}
    alt=""
    widths={[900, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class="hero__scrim"></div>

  <div class="wrap hero__inner">
    <p class="hero__eyebrow">Stavebné práce · Rekonštrukcie · Fasády</p>
    <h1 class="hero__title">Staviame presne a v termíne</h1>
    <p class="hero__lead">
      Hrubé stavby, kompletné rekonštrukcie bytov a domov, fasády a zatepľovanie.
      Pracujeme s vlastnými murárskymi partiami, s pevným rozpisom prác a jasným
      harmonogramom.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#realizacie">Prezrieť realizácie</a>
      <a class="btn btn--ghost" href="#ponuka">Napísať nám</a>
    </div>

    <dl class="stats">
      {
        STATS.map((s) => (
          <div class="stats__item">
            <dt class="stats__value">{s.value}</dt>
            <dd class="stats__label">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 13, 12, 0.82) 0%,
      rgba(14, 13, 12, 0.5) 42%,
      rgba(14, 13, 12, 0.92) 100%
    );
  }

  .hero__inner {
    position: relative;
    padding-block: clamp(6rem, 14vw, 8.25rem) clamp(4rem, 9vw, 6rem);
    color: var(--on-dark);
  }

  .hero__eyebrow {
    font-size: 0.75rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--a2);
    margin-bottom: 1.75rem;
  }

  .hero__title {
    font-size: var(--fs-h1);
    line-height: 0.92;
    letter-spacing: -0.01em;
    max-width: 14ch;
  }

  .hero__lead {
    margin-top: 1.875rem;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.6vw, 1.19rem);
    line-height: 1.6;
    color: var(--on-dark-80);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  /* Mriežka čísel — auto-fit znamená, že pridanie piateho údaja
     do STATS nič nerozbije. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 1px;
    margin: 5.25rem 0 0;
    background: var(--hairline-dark);
  }

  .stats__item {
    background: var(--ink);
    padding: 1.5rem 1.625rem;
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--a2);
  }

  .stats__label {
    margin: 0.25rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-65);
  }
</style>
