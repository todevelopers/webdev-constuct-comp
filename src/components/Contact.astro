---
/**
 * Kontakt + mapa.
 *
 * Mapa sa načíta automaticky, priamo v stránke, ako obyčajný <iframe> —
 * bez jediného riadka JavaScriptu, takže funguje aj s vypnutým JS.
 *
 * Podklady sú z OpenStreetMap, nie z Google. Vložená Google mapa posiela IP
 * adresu a cookies každého návštevníka Googlu ešte pred akýmkoľvek súhlasom
 * (GDPR) a stiahne ~600 kB pri každom otvorení stránky. OpenStreetMap
 * nenasadzuje reklamné cookies a je násobne ľahší. Odkaz do Google Máp
 * zostáva pod mapou — kým naň niekto neklikne, Googlu neodíde nič.
 *
 * `loading="lazy"` = prehliadač mapu stiahne až keď sa k nej návštevník
 * doroluje. Stále automaticky, ale nespomaľuje prvé zobrazenie stránky.
 */
import { CONTACT, MAP_EMBED, MAP_LINK, SITE } from '../data/site';

const mapTitle = `Mapa – sídlo ${SITE.name}, ${CONTACT.address.street}, ${CONTACT.address.city}`;
---

<section class="section section--ink" id="kontakt">
  <div class="wrap">
    <p class="eyebrow">Kontakt</p>
    <h2 class="section-title">Kde nás nájdete</h2>

    <div class="cols">
      <div class="details">
        <div class="row">
          <p class="row__key">Telefón</p>
          <p class="row__val"><a class="row__link" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a></p>
        </div>

        <div class="row">
          <p class="row__key">E-mail</p>
          <p class="row__val"><a class="row__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        </div>

        <div class="row">
          <p class="row__key">Sídlo</p>
          <address class="row__addr">
            {CONTACT.address.street}, {CONTACT.address.postalCode} {CONTACT.address.city}<br />
            IČO {CONTACT.ico} · DIČ {CONTACT.dic}
          </address>
        </div>

        <div class="row">
          <p class="row__key">Obhliadky</p>
          <p class="row__addr">
            {
              CONTACT.openingHours.map((h) => (
                <>
                  {h.days}, {h.hours}
                  <br />
                </>
              ))
            }
          </p>
        </div>

        <a class="btn btn--primary cta" href="#ponuka">Chcem cenovú ponuku</a>
      </div>

      <div class="map">
        <iframe
          class="map__frame"
          src={MAP_EMBED}
          title={mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer"></iframe>

        <p class="map__foot">
          <a class="map__out" href={MAP_LINK} target="_blank" rel="noopener noreferrer">Otvoriť v Google Mapách</a>
          <span class="map__attr">Mapa © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(2.25rem, 5vw, 4.5rem);
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    align-items: stretch;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 1.625rem;
  }

  .row__key {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-45);
  }

  .row__val {
    font-size: 1.3rem;
    margin-top: 0.25rem;
  }

  .row__link {
    color: var(--on-dark);
  }

  .row__link:hover {
    color: var(--a1);
  }

  .row__addr {
    margin-top: 0.25rem;
    font-size: 1.06rem;
    line-height: 1.5;
    font-style: normal;
    color: var(--on-dark-80);
  }

  .cta {
    align-self: flex-start;
    margin-top: 0.375rem;
    padding: 1rem 1.75rem;
    font-size: 0.78rem;
  }

  .map {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #171513;
    overflow: hidden;
  }

  .map__frame {
    flex: 1;
    display: block;
    width: 100%;
    min-height: 320px;
    border: 0;
    /* Podklady OpenStreetMap sú svetlé — filter ich preladí do tmavej sekcie. */
    filter: invert(0.92) hue-rotate(180deg) brightness(0.94) contrast(0.9) saturate(0.7);
  }

  .map__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .map__out {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-80);
  }

  .map__out:hover {
    color: var(--a1);
  }

  .map__attr {
    font-size: 0.72rem;
    color: var(--on-dark-45);
  }

  .map__attr a {
    color: inherit;
    text-decoration: underline;
  }

  .map__attr a:hover {
    color: var(--a1);
  }
</style>
