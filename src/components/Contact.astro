---
/**
 * Kontakt + mapa.
 *
 * Mapa sa NEnačítava automaticky. Vložený Google iframe posiela IP adresu a
 * cookies návštevníka Googlu ešte pred akýmkoľvek súhlasom — čo je pri GDPR
 * problém a zároveň to stojí ~600 kB a niekoľko sto ms pri načítaní stránky.
 * Namiesto toho je tu „fasáda“: mapa sa načíta až na kliknutie a bez
 * JavaScriptu zostáva obyčajný odkaz do Google Máp.
 */
import { CONTACT, MAP_LINK } from '../data/site';

const mapEmbed =
  'https://maps.google.com/maps?output=embed&z=15&q=' +
  encodeURIComponent(
    `${CONTACT.address.street}, ${CONTACT.address.postalCode} ${CONTACT.address.city}`,
  );
---

<section class="section section--ink" id="kontakt">
  <div class="wrap">
    <p class="eyebrow">Kontakt</p>
    <h2 class="section-title">Kde nás nájdete</h2>

    <div class="cols">
      <div class="details">
        <div class="row">
          <p class="row__key">Telefón</p>
          <p class="row__val"><a class="row__link" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a></p>
        </div>

        <div class="row">
          <p class="row__key">E-mail</p>
          <p class="row__val"><a class="row__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
        </div>

        <div class="row">
          <p class="row__key">Sídlo</p>
          <address class="row__addr">
            {CONTACT.address.street}, {CONTACT.address.postalCode} {CONTACT.address.city}<br />
            IČO {CONTACT.ico} · DIČ {CONTACT.dic}
          </address>
        </div>

        <div class="row">
          <p class="row__key">Obhliadky</p>
          <p class="row__addr">
            {
              CONTACT.openingHours.map((h) => (
                <>
                  {h.days}, {h.hours}
                  <br />
                </>
              ))
            }
          </p>
        </div>

        <a class="btn btn--primary cta" href="#ponuka">Chcem cenovú ponuku</a>
      </div>

      <div class="map" data-map data-src={mapEmbed}>
        <a class="map__link" href={MAP_LINK} target="_blank" rel="noopener noreferrer">
          <span class="map__pin" aria-hidden="true"></span>
          <span class="map__label">Otvoriť v Google Mapách</span>
          <span class="map__addr">
            {CONTACT.address.street}, {CONTACT.address.postalCode} {CONTACT.address.city}
          </span>
        </a>
        <button class="map__load" type="button" data-map-load hidden>Načítať mapu tu</button>
      </div>
    </div>
  </div>
</section>

<script>
  const map = document.querySelector<HTMLElement>('[data-map]');
  const load = document.querySelector<HTMLButtonElement>('[data-map-load]');

  if (map && load) {
    // Tlačidlo sa objaví len keď beží JS — inak ostáva odkaz do Google Máp.
    load.hidden = false;
    load.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = map.dataset.src ?? '';
        iframe.title = 'Mapa – sídlo firmy';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.className = 'map__frame';
        map.replaceChildren(iframe);
      },
      { once: true },
    );
  }
</script>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(2.25rem, 5vw, 4.5rem);
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    align-items: stretch;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 1.625rem;
  }

  .row__key {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-45);
  }

  .row__val {
    font-size: 1.3rem;
    margin-top: 0.25rem;
  }

  .row__link {
    color: var(--on-dark);
  }

  .row__link:hover {
    color: var(--a1);
  }

  .row__addr {
    margin-top: 0.25rem;
    font-size: 1.06rem;
    line-height: 1.5;
    font-style: normal;
    color: var(--on-dark-80);
  }

  .cta {
    align-self: flex-start;
    margin-top: 0.375rem;
    padding: 1rem 1.75rem;
    font-size: 0.78rem;
  }

  .map {
    position: relative;
    display: flex;
    min-height: 320px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #171513;
    overflow: hidden;
  }

  .map__link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem;
    text-align: center;
    color: var(--on-dark);
    /* Jemný raster, aby plocha pôsobila ako mapa, nie ako prázdny box. */
    background-image:
      linear-gradient(var(--hairline-dark-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline-dark-soft) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .map__link:hover {
    color: var(--a1);
  }

  .map__pin {
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--a1);
  }

  .map__label {
    font-size: 0.78rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .map__addr {
    font-size: 0.9rem;
    color: var(--on-dark-65);
  }

  .map__load {
    position: absolute;
    bottom: 0.875rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.625rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(14, 13, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--on-dark-80);
    cursor: pointer;
    transition: background-color var(--transition);
  }

  .map__load:hover {
    background: var(--a1);
    color: var(--ink2);
  }

  .map :global(.map__frame) {
    width: 100%;
    min-height: 320px;
    border: 0;
    filter: invert(0.92) hue-rotate(180deg) brightness(0.94) contrast(0.9) saturate(0.7);
  }
</style>
