---
/**
 * Formulár cenovej ponuky.
 *
 * Obyčajný HTML <form method="post"> — odošle sa aj s vypnutým JavaScriptom.
 * Žiadny stavový komponent, žiadne fetch volanie, žiadna atrapa: keď nie je
 * nastavený endpoint, formulár to POVIE namiesto toho, aby predstieral
 * úspešné odoslanie a dopyt potichu zahodil.
 *
 * Ochrana proti spamu je dvojitá a bez CAPTCHA:
 *   1. honeypot – skryté pole, ktoré vyplnia len boti
 *   2. časová pečiatka – odoslanie do 3 sekúnd od načítania je takmer isto bot
 * Obidve vyhodnocuje až príjemca (Formspree, Netlify alebo vlastný backend).
 */
import { FORM, SITE } from '../data/site';
import { SERVICES, QUOTE_PROMISES } from '../data/services';

const configured = FORM.provider === 'netlify' || FORM.action.length > 0;
const action = FORM.provider === 'netlify' ? undefined : FORM.action || undefined;
---

<section class="section section--paper divider" id="ponuka">
  <div class="wrap cols">
    <div>
      <p class="eyebrow">Cenová ponuka</p>
      <h2 class="section-title narrow">Nezáväzná cenová ponuka</h2>
      <p class="lead intro">
        Napíšte nám rozsah prác a lokalitu. Ozveme sa do 48 hodín a dohodneme
        obhliadku. Ponuka obsahuje rozpis prác, cenu za merné jednotky a
        harmonogram.
      </p>

      <ul class="promises">
        {QUOTE_PROMISES.map((p) => <li class="promises__item">{p}</li>)}
      </ul>
    </div>

    <div class="panel">
      {
        !configured && (
          <p class="warn" role="status">
            <strong>Formulár zatiaľ nie je napojený.</strong> Doplň endpoint do
            <code>FORM.action</code> v <code>src/data/site.ts</code>, inak sa odoslané
            dopyty nikam nedoručia.
          </p>
        )
      }

      <form
        class="form"
        method="post"
        action={action}
        data-netlify={FORM.provider === 'netlify' ? 'true' : undefined}
        name="cenova-ponuka"
        data-form
      >
        {/* Formspree: kam presmerovať po odoslaní + predmet e-mailu. */}
        <input type="hidden" name="_redirect" value={new URL(FORM.successPath, SITE.url).href} />
        <input type="hidden" name="_subject" value={`Nový dopyt z webu ${SITE.name}`} />
        {/* Vyplní skript; prázdna hodnota = používateľ bez JS, nevyhodnocuje sa. */}
        <input type="hidden" name="nacitane" data-loaded-at value="" />

        {/* Honeypot — skrytý pred ľuďmi, lákavý pre boty. */}
        <div class="honeypot" aria-hidden="true">
          <label>
            Nevypĺňajte toto pole
            <input type="text" name={FORM.honeypotField} tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="fields">
          <label class="field">
            <span class="field__label">Meno a priezvisko *</span>
            <input
              class="field__input"
              type="text"
              name="meno"
              required
              autocomplete="name"
              placeholder="Ján Novák"
            />
          </label>

          <label class="field">
            <span class="field__label">Telefón *</span>
            <input
              class="field__input"
              type="tel"
              name="telefon"
              required
              autocomplete="tel"
              placeholder="+421"
            />
          </label>

          <label class="field">
            <span class="field__label">E-mail *</span>
            <input
              class="field__input"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="jan.novak@email.sk"
            />
          </label>

          <label class="field">
            <span class="field__label">Typ práce *</span>
            <select class="field__input" name="typ_prace" required>
              <option value="">Vyberte typ práce</option>
              {SERVICES.map((s) => <option value={s.slug}>{s.title}</option>)}
              <option value="ine">Iné / kombinácia prác</option>
            </select>
          </label>
        </div>

        <label class="field field--full">
          <span class="field__label">Správa</span>
          <textarea
            class="field__input field__textarea"
            name="sprava"
            rows="4"
            placeholder="Rozsah prác, lokalita, predstava o termíne…"></textarea>
        </label>

        <div class="submit">
          <p class="consent">
            Odoslaním súhlasíte so spracovaním údajov za účelom vypracovania ponuky.
          </p>
          <button class="btn btn--solid" type="submit">Odoslať žiadosť</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Čas načítania formulára — príjemca podľa neho odhalí okamžité odoslanie
  // botom. Bez JS zostane pole prázdne a pravidlo sa jednoducho neuplatní.
  document
    .querySelectorAll<HTMLInputElement>('[data-loaded-at]')
    .forEach((el) => (el.value = String(Date.now())));
</script>

<style>
  .divider {
    border-top: 1px solid var(--line2);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .narrow {
    max-width: 14ch;
  }

  .intro {
    margin-top: 1.375rem;
    max-width: 44ch;
    color: var(--body);
  }

  .promises {
    margin: 2.125rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .promises__item {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line2);
    font-size: 0.97rem;
    color: var(--body);
  }

  .panel {
    border: 1px solid var(--line2);
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 2.75rem) clamp(1.75rem, 4vw, 3rem);
  }

  .warn {
    margin-bottom: 1.5rem;
    padding: 0.875rem 1rem;
    border-left: 3px solid var(--a4);
    background: color-mix(in srgb, var(--a1) 12%, transparent);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink2);
  }

  .warn code {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field--full {
    margin-top: 1.5rem;
  }

  .field__label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .field__input {
    border: 0;
    border-bottom: 1px solid var(--line2);
    border-radius: 0;
    background: none;
    padding: 0.625rem 0;
    font-size: 1.03rem;
    color: var(--ink2);
    outline: none;
    transition: border-color var(--transition);
  }

  .field__input:focus {
    border-bottom-color: var(--a4);
  }

  /* Chybu ukáž až keď používateľ pole opustil, nie počas písania. */
  .field__input:user-invalid {
    border-bottom-color: #b00020;
  }

  .field__textarea {
    border: 1px solid var(--line2);
    padding: 0.75rem 0.875rem;
    resize: vertical;
  }

  .field__textarea:focus {
    border-color: var(--a4);
  }

  .submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .consent {
    max-width: 38ch;
    font-size: 0.81rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Skryté pred ľuďmi aj pred čítačkami, ale stále v DOM pre boty. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
